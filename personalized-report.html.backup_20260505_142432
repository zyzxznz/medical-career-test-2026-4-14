        // 显示岗位详情弹窗
        function showPositionDetail(positionName) {
            const mappedName = positionNameMap[positionName] || positionName;
            const position = positionDatabase[mappedName];
            
            if (!position) {
                alert('暂无该岗位的详细信息，敬请期待！');
                return;
            }

            // 更新弹窗内容
            document.getElementById('modal-position-name').textContent = mappedName;
            document.getElementById('modal-brief').textContent = position.brief;
            
            // 主要工作内容
            const mainWorkList = document.getElementById('modal-main-work');
            mainWorkList.innerHTML = '';
            position.mainWork.forEach(item => {
                const li = document.createElement('li');
                li.textContent = item;
                mainWorkList.appendChild(li);
            });
            
            // 其他信息
            document.getElementById('modal-requirements').textContent = position.requirements;
            document.getElementById('modal-salary').textContent = position.salary;
            document.getElementById('modal-development').textContent = position.development;
            
            // 设置搜索按钮（预留接口）
            const searchBtn = document.getElementById('modal-search-btn');
            if (position.searchUrl) {
                searchBtn.onclick = function() {
                    window.open(position.searchUrl, '_blank');
                };
                searchBtn.style.display = 'block';
                document.getElementById('search-pending-notice').style.display = 'none';
            } else {
                searchBtn.style.display = 'none';
                document.getElementById('search-pending-notice').style.display = 'block';
            }
            
            // 显示弹窗
            document.getElementById('position-modal-overlay').classList.add('active');
        }

        // 关闭岗位详情弹窗
        function closePositionModal() {
            document.getElementById('position-modal-overlay').classList.remove('active');
        }

        // 点击遮罩关闭弹窗
        document.getElementById('position-modal-overlay').addEventListener('click', function(e) {
            if (e.target === this) {
                closePositionModal();
            }
        });
    </script>

